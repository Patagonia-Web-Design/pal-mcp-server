    "planner": {
      "prompt_path": "systemprompts/clink/agy_planner.txt",
      "role_args": []
    },
    "codereviewer": {
      "prompt_path": "systemprompts/clink/agy_codereviewer.txt",
      "role_args": []
    }
  }
}
