{
  "name": "agy",
  "command": "agy",
  "additional_args": [
    "--mode",
    "plan",
    "--print-timeout",
    "{timeout_seconds}s"
  ],
  "env": {},
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/agy_default.txt",
